NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password
DB_NAME=copd_care
# Leave unset for local development defaults. Set false in production.
DB_SYNCHRONIZE=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=24h

# Comma-separated origins for browser clients. Example:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

AIR_KOREA_SERVICE_KEY=
